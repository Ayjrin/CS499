generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  length      String
  start       DateTime
  resort      String
  perPerson   String
  image       String
  description String
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
  hash  String
  salt  String
}
